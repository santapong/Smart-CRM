generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth Prisma adapter) ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  ownedDeals  Deal[]       @relation("DealOwner")
  activities  Activity[]   @relation("ActivityOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Tenancy ----------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships     Membership[]
  companies       Company[]
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  stages          PipelineStage[]
  tags            Tag[]
  dealStageEvents DealStageEvent[]
  pipelines       Pipeline[]
  customFieldDefs CustomFieldDefinition[]
  savedViews      SavedView[]
  outboxEvents    OutboxEvent[]
  subscription    Subscription?
  entitlements    Entitlement[]
  emailMessages   EmailMessage[]
  suppressions    Suppression[]
  sendingDomains  SendingDomain[]
  leads           Lead[]
  leadLabels      LeadLabel[]
  forms           Form[]
  formSubmissions FormSubmission[]
  workflows       Workflow[]
  workflowRuns    WorkflowRun[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role   @default(MEMBER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

// ---------- CRM domain ----------

model Company {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  domain       String?
  industry     String?
  size         String?
  notes        String?  @db.Text
  customFields Json?
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]

  @@index([orgId, name])
}

model Contact {
  id           String   @id @default(cuid())
  orgId        String
  companyId    String?
  firstName    String
  lastName     String
  email        String?
  phone        String?
  title        String?
  notes        String?  @db.Text
  customFields Json?
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tags       ContactTag[]
  deals      Deal[]
  activities Activity[]

  @@index([orgId, lastName])
  @@index([orgId, email])
}

model Tag {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String @default("#64748b")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([orgId, name])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// A named sales process; an org can have many (M6 — multiple pipelines).
model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([orgId, name])
  @@index([orgId, order])
}

model PipelineStage {
  id          String  @id @default(cuid())
  orgId       String
  pipelineId  String?
  name        String
  order       Int
  color       String  @default("#3b82f6")
  rottenDays  Int?
  probability Int?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@index([orgId, name])
  @@index([orgId, order])
  @@index([pipelineId, order])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id           String     @id @default(cuid())
  orgId        String
  title        String
  value        Decimal    @default(0) @db.Decimal(12, 2)
  currency     String     @default("USD")
  status       DealStatus @default(OPEN)
  stageId      String
  pipelineId   String?
  companyId    String?
  contactId    String?
  ownerId      String?
  probability  Int?
  closeDate    DateTime?
  notes        String?    @db.Text
  customFields Json?
  version      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage       PipelineStage    @relation(fields: [stageId], references: [id])
  pipeline    Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner       User?            @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]
  stageEvents DealStageEvent[]

  @@index([orgId, stageId])
  @@index([orgId, status])
  @@index([orgId, pipelineId])
}

enum ActivityType {
  TASK
  CALL
  MEETING
  NOTE
}

model Activity {
  id          String       @id @default(cuid())
  orgId       String
  type        ActivityType @default(TASK)
  title       String
  body        String?      @db.Text
  dueAt       DateTime?
  completedAt DateTime?
  contactId   String?
  dealId      String?
  ownerId     String?
  version     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner   User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([orgId, dueAt])
  @@index([orgId, completedAt])
}

// ---------- Analytics ----------

// Append-only log of deal stage/status transitions. Powers funnel,
// velocity and win-rate analytics (see docs/research/briefs/backend/15).
model DealStageEvent {
  id          String      @id @default(cuid())
  orgId       String
  dealId      String
  fromStageId String?
  toStageId   String?
  fromStatus  DealStatus?
  toStatus    DealStatus?
  value       Decimal     @default(0) @db.Decimal(12, 2)
  changedById String?
  changedAt   DateTime    @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, dealId])
  @@index([orgId, toStageId])
  @@index([orgId, changedAt])
}

// ---------- Platform foundations ----------

// Per-org custom field definitions (M3). Values live in the JSONB
// `customFields` column on Contact/Company/Deal.
model CustomFieldDefinition {
  id        String   @id @default(cuid())
  orgId     String
  entity    String // "contact" | "company" | "deal"
  key       String
  label     String
  type      String // "text" | "number" | "date" | "boolean" | "select"
  config    Json?
  required  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entity, key])
  @@index([orgId, entity])
}

// Transactional outbox (M2): domain events written in the same tx as a
// mutation, then drained/fanned-out by a background worker.
model OutboxEvent {
  id          String    @id @default(cuid())
  orgId       String?
  name        String
  payload     Json
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Billing/entitlements (M4). Plans are code-defined; this mirrors Stripe.
model Subscription {
  id                   String    @id @default(cuid())
  orgId                String    @unique
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Per-org feature/limit overrides (M4).
model Entitlement {
  id       String  @id @default(cuid())
  orgId    String
  key      String
  intValue Int?
  boolValue Boolean?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

// Saved/shared list views with stored filters (M6).
model SavedView {
  id        String   @id @default(cuid())
  orgId     String
  ownerId   String?
  entity    String // "contact" | "company" | "deal" | "activity"
  name      String
  filters   Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entity])
}

// ---------- Email (M7) ----------

// A single email tied to a tenant (and optionally a contact/deal). Records both
// real sends and env-gated "skipped" placeholders so the timeline is complete
// even without a Resend key configured.
model EmailMessage {
  id                String   @id @default(cuid())
  orgId             String
  contactId         String?
  dealId            String?
  direction         String // "outbound" | "inbound"
  status            String // "sent" | "skipped" | "failed" | "queued"
  subject           String
  body              String   @db.Text
  fromAddr          String
  toAddr            String
  providerMessageId String?
  threadId          String?
  firstOpenedAt     DateTime?
  openCount         Int      @default(0)
  lastClickedAt     DateTime?
  clickCount        Int      @default(0)
  sentById          String?
  createdAt         DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events EmailEvent[]

  @@index([orgId, createdAt])
  @@index([orgId, contactId])
  @@index([orgId, dealId])
}

// Provider delivery/engagement events (opened, clicked, bounced, complained).
// `providerEventId` is unique so webhook retries are idempotent.
model EmailEvent {
  id              String   @id @default(cuid())
  emailMessageId  String
  type            String
  providerEventId String?  @unique
  createdAt       DateTime @default(now())

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
}

// Per-org suppression list — addresses we must not email (bounced/complained).
model Suppression {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  reason    String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
}

// Per-org verified sending domains (for DKIM/SPF via the provider).
model SendingDomain {
  id        String   @id @default(cuid())
  orgId     String
  domain    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, domain])
}

// One-time password-reset tokens (D2). Not tenant-scoped — keyed by email so a
// user can reset before selecting an org.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------- Leads & web forms (M8) ----------

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

// An inbound prospect captured before it becomes a Deal. Converting a lead
// creates a Deal in the org's default pipeline and links it via convertedDealId.
model Lead {
  id              String     @id @default(cuid())
  orgId           String
  title           String
  value           Decimal?   @db.Decimal(12, 2)
  currency        String     @default("USD")
  status          LeadStatus @default(NEW)
  ownerId         String?
  contactId       String?
  companyId       String?
  source          String?
  sourceChannel   String?
  utm             Json?
  notes           String?    @db.Text
  customFields    Json?
  version         Int        @default(0)
  convertedDealId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  org    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  labels LeadLabelOnLead[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model LeadLabel {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String @default("#64748b")

  org   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads LeadLabelOnLead[]

  @@unique([orgId, name])
}

model LeadLabelOnLead {
  leadId  String
  labelId String

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  label LeadLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([leadId, labelId])
}

// A public web form whose submissions create Leads (or other targets). `fields`
// is a JSON array of { key, label, type, required } definitions.
model Form {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  fields      Json
  target      String   @default("lead")
  pipelineId  String?
  redirectUrl String?
  active      Boolean  @default(true)
  submitCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([orgId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  orgId     String
  formId    String
  leadId    String?
  data      Json
  utm       Json?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form Form         @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([orgId, formId])
}

// ---------- No-code workflow automation (M9) ----------

// A trigger → conditions → ordered actions rule. `definition` is a JSON array of
// action steps ({ type, ...params }); `conditions` is a JSON Logic rule evaluated
// against the trigger context. Workflows run when a matching domain event is
// drained from the outbox (see src/lib/workflows/engine.ts).
model Workflow {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  triggerEvent String
  conditions   Json?
  definition   Json
  enabled      Boolean  @default(true)
  runCount     Int      @default(0)
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs WorkflowRun[]

  @@index([orgId, triggerEvent, enabled])
}

// One execution of a Workflow against a single trigger event. `context` is the
// serialized trigger context (event + loaded record).
model WorkflowRun {
  id           String    @id @default(cuid())
  orgId        String
  workflowId   String
  status       String    @default("running") // running | done | failed
  triggerEvent String
  context      Json
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    StepRun[]

  @@index([orgId, workflowId])
}

// One executed action step within a WorkflowRun.
model StepRun {
  id        String   @id @default(cuid())
  runId     String
  idx       Int
  type      String
  status    String // done | failed | skipped
  output    Json?
  createdAt DateTime @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
