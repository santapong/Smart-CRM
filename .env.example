# ────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────
# Local dev: point at the Postgres started by `docker compose up -d`.
# Vercel / production: use a POOLED connection string (PgBouncer transaction
# mode) from your Postgres provider — Neon, Supabase, Vercel Postgres, etc.
# Each Vercel serverless invocation opens a new connection, so a non-pooled
# direct URL will exhaust the database under load.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcrm?schema=public"

# Direct (non-pooled) URL, used only by `prisma migrate` / `prisma db push`.
# Optional locally — when unset, Prisma falls back to DATABASE_URL.
# Required when DATABASE_URL points at a transaction-mode pooler that doesn't
# support the prepared statements migrations rely on.
DIRECT_URL=""

# ────────────────────────────────────────────────────────────────────────────
# NextAuth (v5)
# ────────────────────────────────────────────────────────────────────────────
# Generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Local: full URL with port. On Vercel native deployments this is auto-set;
# you can leave it blank in the Vercel dashboard.
AUTH_URL="http://localhost:3000"

# Set to `true` when deploying behind a proxy/CDN (Vercel preview URLs,
# custom domains, etc.) so NextAuth trusts the Host header. Required on
# Vercel for non-production deploys to log in.
AUTH_TRUST_HOST="true"

# ────────────────────────────────────────────────────────────────────────────
# Email (optional)
# ────────────────────────────────────────────────────────────────────────────
EMAIL_FROM="no-reply@example.com"
RESEND_API_KEY=""
# Resend (Svix) webhook signing secret (whsec_…). Leave blank to keep the
# /api/email/webhook route a 200 no-op. Set to verify open/click/bounce events.
RESEND_WEBHOOK_SECRET=""

# ────────────────────────────────────────────────────────────────────────────
# Async backbone — Inngest (M2, optional)
# ────────────────────────────────────────────────────────────────────────────
# Only required to connect to Inngest Cloud. Leave blank for local dev / CI —
# the transactional outbox works without them.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ────────────────────────────────────────────────────────────────────────────
# Billing — Stripe (M4, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to run fully offline: the Stripe client is null and the webhook
# route returns 501 (disabled). Set both to enable billing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ────────────────────────────────────────────────────────────────────────────
# Rate limiting — Upstash Redis (M1, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to run fully offline: src/lib/ratelimit.ts falls back to a no-op
# limiter that always allows. Set both to enable sliding-window rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ────────────────────────────────────────────────────────────────────────────
# Error monitoring — Sentry (M1, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to keep Sentry off: instrumentation.ts only initializes the SDK
# when SENTRY_DSN is set. NEXT_PUBLIC_SENTRY_DSN enables the browser SDK.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ────────────────────────────────────────────────────────────────────────────
# AI assistant — Claude / Anthropic (M14, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to run fully offline: src/lib/ai.ts returns a graceful
# "AI is not configured" result and the AI actions never throw. Set the key to
# enable live drafting / summarizing / qualifying. AI_MODEL overrides the
# default model ("claude-sonnet-4-6").
ANTHROPIC_API_KEY=""
AI_MODEL=""

# ────────────────────────────────────────────────────────────────────────────
# Integrations framework (M15, optional)
# ────────────────────────────────────────────────────────────────────────────
# Secrets vault key — base64-encoded 32 bytes (AES-256-GCM).
# Generate with: `openssl rand -base64 32`
# Leave blank for local dev / CI: src/lib/crypto.ts derives a clearly-labeled
# DEV-ONLY fallback key (keyId="dev") so encrypt/decrypt still works. DO NOT
# rely on the fallback in production — set a real key there.
ENCRYPTION_KEY=""

# Nango (https://nango.dev) — managed OAuth for Gmail / Google Calendar.
# Leave blank to keep those providers scaffolded/disabled: the UI shows a
# "set NANGO_* to enable" hint and src/lib/integrations/nango.ts returns
# not-configured. No live calls are made without a secret key.
NANGO_SECRET_KEY=""
NANGO_HOST="https://api.nango.dev"

# ────────────────────────────────────────────────────────────────────────────
# SSO (SAML) + SCIM — BoxyHQ Jackson (M16, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to keep SSO/SCIM scaffolded: the /api/auth/sso and /api/scim/v2
# routes return 501 and the Settings UI shows a "set JACKSON_* to enable" hint.
# When set, point JACKSON_URL at a running BoxyHQ Jackson controller (its SAML
# metadata + SCIM endpoints); JACKSON_API_KEY authenticates the management API.
# NOTE: the heavy @boxyhq/saml-jackson package is intentionally NOT bundled.
JACKSON_URL=""
JACKSON_API_KEY=""

# ────────────────────────────────────────────────────────────────────────────
# Real-time collaboration — Pusher Channels (M17, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to run fully offline: src/lib/realtime.ts publish() is a no-op,
# the /api/realtime/auth route returns 501, and the client hooks never load the
# pusher-js chunk (live Kanban refresh + presence avatars are simply inert).
# Set all of these (free dev tier at https://pusher.com) to go live. The two
# NEXT_PUBLIC_* values are the same key/cluster, exposed to the browser SDK.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ────────────────────────────────────────────────────────────────────────────
# Smart-Docs file storage — Vercel Blob (M18, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to store uploads on the LOCAL filesystem (.uploads/, gitignored) —
# file upload/download works with zero config. Set this to a Vercel Blob
# read-write token to store uploads in Vercel Blob instead (the @vercel/blob
# package is loaded lazily only when this is present). See src/lib/storage.ts.
BLOB_READ_WRITE_TOKEN=""

# ────────────────────────────────────────────────────────────────────────────
# eSignature — Dropbox Sign (M18, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to keep eSign scaffolded: createSignatureRequest still records the
# request (PENDING) but does not send, and the /api/esign/webhook route returns
# 501. Set DROPBOX_SIGN_API_KEY to enable live sending. NOTE: the provider SDK is
# intentionally NOT bundled (see src/lib/esign.ts).
DROPBOX_SIGN_API_KEY=""

# ────────────────────────────────────────────────────────────────────────────
# Search — Meilisearch (M19a, optional)
# ────────────────────────────────────────────────────────────────────────────
# Leave blank to use Postgres full-text search (the live default — zero config,
# multi-tenant, ranked). Set MEILISEARCH_HOST (and optionally MEILISEARCH_KEY) to
# route globalSearch through a Meilisearch instance instead. NOTE: the Meili SDK
# is intentionally NOT bundled yet — src/lib/search-meili.ts is a scaffold that
# falls back to Postgres FTS until wired (mirrors the SSO/eSign scaffolds).
MEILISEARCH_HOST=""
MEILISEARCH_KEY=""

# ────────────────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Smart CRM"
